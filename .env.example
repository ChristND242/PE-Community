# Public address used by members. WEB_ORIGIN must include the scheme.
APP_DOMAIN=community.example.com
WEB_ORIGIN=https://community.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Required production secrets. Generate independent values for each entry.
POSTGRES_PASSWORD=<strong-url-safe-database-password>
JWT_SECRET=<generate-a-strong-random-secret>
PASSWORD_PEPPER=<generate-a-strong-random-secret>
PASSWORD_PEPPER_PREVIOUS=
EMAIL_ENCRYPTION_KEY=<generate-a-strong-independent-secret>
REGISTRATION_KEY_HASH_SECRET=<generate-a-strong-independent-secret>

# Recommended when an uninitialized installation is network-accessible.
SETUP_TOKEN=
OWNER_BREAK_GLASS_SECRET=

# Same-origin defaults used by the canonical Compose deployment.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_REALTIME_ORIGIN=
API_PUBLIC_URL=
INTERNAL_API_URL=http://api:4000
SESSION_COOKIE_SECURE=
SESSION_COOKIE_NAME=pe_session

# Optional SMTP fallback. SMTP can also be configured in administration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
