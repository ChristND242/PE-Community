# Generated by install.sh for the selected PE Community project directory.
PE_UPDATER_SHARED_SECRET=<generate-at-least-32-random-characters>
# Optional during a controlled secret rotation only. Remove after API cutover.
PE_UPDATER_SHARED_SECRET_PREVIOUS=
PE_UPDATER_PROJECT_ROOT=<project-root>
PE_UPDATER_DEPLOYMENT_ROOT=<project-root>
PE_UPDATER_ROOT=<project-root>/.pe/updater
PE_UPDATER_STATE_DIR=<project-root>/.pe/updater/state
PE_UPDATER_BACKUP_ROOT=<project-root>/.pe/updater/backups
PE_UPDATER_RUNTIME_DIR=/run/pe-community-updater
PE_UPDATER_SOCKET=/run/pe-community-updater/updater.sock
PE_UPDATER_SOCKET_GID=<updater-service-group-gid>
PE_UPDATER_MINIMUM_FREE_BYTES=5368709120
PE_UPDATER_BACKUP_RETENTION=5
PE_UPDATER_API_HEALTH_URL=http://127.0.0.1/api/v1/health
PE_UPDATER_WEB_HEALTH_URL=http://127.0.0.1/login
