generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum RsvpStatus {
  GOING
  MAYBE
  DECLINED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAuthorMode {
  USER
  COMMUNITY_TEAM
}

enum FeedCommentAuthorMode {
  USER
  COMMUNITY_TEAM
}

enum EventTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EventTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskBoardAutomationRuleType {
  DUE_BEFORE
  OVERDUE
  AUTO_COMPLETE_WHEN_CHECKLIST_DONE
  FLAG_UNASSIGNED
  STALE_TASK_FOLLOW_UP
  CHECKLIST_INCOMPLETE_BEFORE_DUE
  OVERDUE_ESCALATION
}

enum TaskBoardAutomationRuleChangeType {
  CREATED
  UPDATED
  ROLLED_BACK
}

enum TaskBoardAutomationRunStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum TaskBoardAutomationRunMode {
  LIVE
  DRY_RUN
  TEST_NOTIFICATION
}

enum NotificationTemplateKey {
  TASK_BOARD_AUTOMATION_DUE_BEFORE
  TASK_BOARD_AUTOMATION_OVERDUE
  TASK_BOARD_AUTOMATION_TEST
  TASK_BOARD_AUTOMATION_AUTO_COMPLETE
  TASK_BOARD_AUTOMATION_FLAG_UNASSIGNED
  TASK_BOARD_AUTOMATION_STALE_TASK_FOLLOW_UP
  TASK_BOARD_AUTOMATION_CHECKLIST_INCOMPLETE_BEFORE_DUE
  TASK_BOARD_AUTOMATION_OVERDUE_ESCALATION
}

enum TaskBoardVisibility {
  PRIVATE
  PUBLIC
}

enum TaskBoardStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum EventTaskActivityType {
  CREATED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  LABEL_CHANGED
  COMMENT_ADDED
  COMMENT_ARCHIVED
  ARCHIVED
  REORDERED
  ATTACHMENT_ADDED
  ATTACHMENT_ARCHIVED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_UPDATED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_REOPENED
  CHECKLIST_ITEM_ARCHIVED
  CHECKLIST_REORDERED
}

enum ChatConversationType {
  DIRECT
  GROUP
}

enum ChatDeviceStatus {
  ACTIVE
  REVOKED
}

enum ChatDeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum ChatKeyStatus {
  ACTIVE
  RETIRED
  REVOKED
}

enum ChatMediaCategory {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum ChatAttachmentLifecycle {
  ACTIVE
  PENDING_DELETION
  DELETING
  DELETED
  DELETE_FAILED
}

enum ChatMediaDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProfileLinkPlatform {
  WEBSITE
  LINKEDIN
  X
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  GITHUB
  GITLAB
  DISCORD
  WHATSAPP
  TELEGRAM
  MASTODON
  THREADS
  BLUESKY
  OTHER
}

enum ProfileLinkVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  name                 String
  passwordHash         String
  forcePasswordChange  Boolean      @default(false)
  passwordChangedAt    DateTime?
  emailVerifiedAt      DateTime?
  twoFactorEnabled     Boolean      @default(false)
  twoFactorSecret      String?
  twoFactorConfirmedAt DateTime?
  twoFactorReenrollmentRequired Boolean @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  memberships          Membership[]
  sessions             Session[]
  rsvps                EventRsvp[]
  assignedEventTasks   EventTask[] @relation("EventTaskAssignee")
  eventTaskAssignments EventTaskAssignee[] @relation("EventTaskAssignedUser")
  assignedTaskAssignments EventTaskAssignee[] @relation("EventTaskAssignedBy")
  createdEventTasks    EventTask[] @relation("EventTaskCreator")
  eventTaskActivities  EventTaskActivity[] @relation("EventTaskActivityActor")
  eventTaskComments    EventTaskComment[] @relation("EventTaskCommentAuthor")
  eventTaskAttachments EventTaskAttachment[] @relation("EventTaskAttachmentUploader")
  createdEventTaskChecklistItems EventTaskChecklistItem[] @relation("EventTaskChecklistItemCreator")
  completedEventTaskChecklistItems EventTaskChecklistItem[] @relation("EventTaskChecklistItemCompleter")
  createdEventTaskTemplates EventTaskTemplate[] @relation("EventTaskTemplateCreator")
  createdTaskBoards     TaskBoard[] @relation("TaskBoardCreator")
  createdTaskBoardAutomationRules TaskBoardAutomationRule[] @relation("TaskBoardAutomationRuleCreator")
  draftedTaskBoardAutomationRules TaskBoardAutomationRule[] @relation("TaskBoardAutomationRuleDraftUpdatedBy")
  archivedTaskBoardAutomationRules TaskBoardAutomationRule[] @relation("TaskBoardAutomationRuleArchivedBy")
  changedTaskBoardAutomationRuleVersions TaskBoardAutomationRuleVersion[] @relation("TaskBoardAutomationRuleVersionChangedBy")
  createdTaskBoardAutomationPresets TaskBoardAutomationPreset[] @relation("TaskBoardAutomationPresetCreatedBy")
  updatedTaskBoardAutomationPresets TaskBoardAutomationPreset[] @relation("TaskBoardAutomationPresetUpdatedBy")
  updatedNotificationTemplates NotificationTemplate[] @relation("NotificationTemplateUpdatedBy")
  twoFactorBackupCodes UserTwoFactorBackupCode[]
  passwordResetTokens  PasswordResetToken[]
  emailChangeRequests  EmailChangeRequest[]
  emailCampaigns       EmailCampaign[]
  feedLikes            FeedLike[]
  feedComments         FeedComment[]
  feedCommentLikes     FeedCommentLike[]
  createdInviteLinks   CommunityInviteLink[]
  createdChatConversations ChatConversation[] @relation("ChatConversationCreator")
  chatParticipants     ChatConversationParticipant[]
  sentChatMessages     ChatMessage[] @relation("ChatMessageSender")
  deletedChatMessages  ChatMessage[] @relation("ChatMessageDeletedBy")
  hiddenChatMessages   ChatMessageHidden[]
  chatMessageReactions ChatMessageReaction[]
  chatMessageStars     ChatMessageStar[]
  chatMessageReportsMade ChatMessageReport[] @relation("ChatMessageReportReporter")
  chatMessageReportsReceived ChatMessageReport[] @relation("ChatMessageReportReportedUser")
  chatMessageReportsResolved ChatMessageReport[] @relation("ChatMessageReportResolvedBy")
  blockedChatUsers     ChatUserBlock[] @relation("ChatUserBlockBlocker")
  blockedByChatUsers   ChatUserBlock[] @relation("ChatUserBlockBlocked")
  sentChatAttachments  ChatAttachment[] @relation("ChatAttachmentSender")
  chatAttachmentViews  ChatAttachmentView[]
  chatDevices          ChatDevice[] @relation("ChatDeviceUser")
  revokedChatDevices   ChatDevice[] @relation("ChatDeviceRevokedBy")
  chatDeviceKeys       ChatDeviceKey[]
  requestedChatMediaDeletions ChatMediaDeletionOperation[] @relation("ChatMediaDeletionRequestedBy")
  chatPresence         ChatPresence[]
  loginStreaks         UserLoginStreak[]
  loginStreakEvents    UserLoginStreakEvent[]
}

model Organization {
  id          String      @id @default(cuid())
  name        String
  communities Community[]
  createdAt   DateTime    @default(now())
}

model Community {
  id             String                    @id @default(cuid())
  name           String
  slug           String                    @unique
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id])
  memberships    Membership[]
  applications   RegistrationApplication[]
  events         Event[]
  eventTasks     EventTask[]
  eventTaskAssignees EventTaskAssignee[]
  eventTaskActivities EventTaskActivity[]
  eventTaskComments EventTaskComment[]
  eventTaskAttachments EventTaskAttachment[]
  eventTaskChecklistItems EventTaskChecklistItem[]
  eventTaskTemplates EventTaskTemplate[]
  taskBoards      TaskBoard[]
  taskBoardAutomationRules TaskBoardAutomationRule[]
  taskBoardAutomationRuleVersions TaskBoardAutomationRuleVersion[]
  taskBoardAutomationRuns TaskBoardAutomationRun[]
  taskBoardAutomationPresets TaskBoardAutomationPreset[]
  announcements  Announcement[]
  feedLikes      FeedLike[]
  feedComments   FeedComment[]
  feedCommentLikes FeedCommentLike[]
  notifications  Notification[]
  settings       CommunitySettings?
  emailSettings  CommunityEmailSettings?
  reminderSettings CommunityReminderSettings?
  inviteLinks    CommunityInviteLink[]
  emailCampaigns EmailCampaign[]
  notificationTemplates NotificationTemplate[]
  messageTemplates CommunityMessageTemplate[]
  auditLogs      AuditLog[]
  roles          Role[]
  chatConversations ChatConversation[]
  chatDevices       ChatDevice[]
  chatDeviceKeys ChatDeviceKey[]
  chatAttachments ChatAttachment[]
  chatStorageUsage CommunityChatStorageUsage?
  chatMediaDeletionOperations ChatMediaDeletionOperation[]
  chatPresence   ChatPresence[]
  chatMessageReports ChatMessageReport[]
  loginStreaks   UserLoginStreak[]
  loginStreakEvents UserLoginStreakEvent[]
  createdAt      DateTime                  @default(now())
}

model CommunityMessageTemplate {
  id              String    @id @default(cuid())
  communityId     String
  key             String
  locale          String    @default("en")
  channel         String
  title           String
  subject         String
  previewText     String?
  heading         String
  greeting        String?
  body            String
  buttonLabel     String?
  fallbackLinkInstructions String?
  expirationNotice String?
  securityNotice  String?
  footerExplanation String?
  defaultBody     String
  defaultContent  Json?
  variablesJson   Json
  isEditable      Boolean   @default(true)
  isSystem        Boolean   @default(false)
  needsReview     Boolean   @default(false)
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  community       Community @relation(fields: [communityId], references: [id])

  @@unique([communityId, key, locale])
  @@index([communityId, key])
}

model NotificationTemplate {
  id            String                  @id @default(cuid())
  communityId   String
  key           NotificationTemplateKey
  name          String
  description   String?
  channelScope  Json
  enabled       Boolean                 @default(true)
  version       Int                     @default(1)
  subjectEn     String?
  subjectFr     String?
  inAppTitleEn  String
  inAppTitleFr  String
  inAppBodyEn   String
  inAppBodyFr   String
  emailTitleEn  String?
  emailTitleFr  String?
  emailBodyEn   String?
  emailBodyFr   String?
  buttonLabelEn String?
  buttonLabelFr String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  updatedById   String?
  community     Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedBy     User?                   @relation("NotificationTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([communityId, key])
  @@index([communityId, enabled])
}

model CommunitySettings {
  id                        String    @id @default(cuid())
  communityId               String    @unique
  twoFactorEnabled          Boolean   @default(false)
  defaultLanguage           String    @default("en")
  timezone                  String    @default("UTC")
  registrationApprovalMode  String    @default("portal_registration")
  memberDirectoryVisibility String    @default("members_only")
  supportContactEmail       String?
  adminInAppAlertsEnabled   Boolean   @default(true)
  emailDeliveryIssueAlertsEnabled Boolean @default(true)
  registrationReviewAlertsEnabled Boolean @default(true)
  registrationCaptchaEnabled Boolean @default(false)
  registrationCaptchaMode String @default("DISABLED")
  registrationCaptchaProvider String @default("DISABLED")
  registrationCaptchaVariant String?
  registrationCaptchaSiteKey String?
  registrationCaptchaSecretEncrypted String?
  registrationCaptchaHostname String?
  registrationCaptchaAction String?
  registrationCaptchaMinimumScore Float @default(0.5)
  registrationIpLimit Int @default(3)
  registrationIpWindowMinutes Int @default(15)
  registrationNotificationCooldownHours Int @default(12)
  registrationGlobalEmailDailyLimit Int @default(2)
  passportExpirationAdminAlertsEnabled Boolean @default(true)
  reminderRunSummaryAlertsEnabled Boolean @default(false)
  maxActiveChatDevices      Int       @default(3)
  chatMediaQuotaBytes       BigInt?
  chatMediaWarningPercent   Int       @default(80)
  chatAttachmentMaxBytes    Int       @default(10485760)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  community                 Community @relation(fields: [communityId], references: [id])
}

model UserLoginStreak {
  id            String    @id @default(cuid())
  communityId   String
  userId        String
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLoginDate DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, currentStreak])
  @@index([communityId, longestStreak])
  @@index([communityId, lastLoginAt])
}

model UserLoginStreakEvent {
  id                    String    @id @default(cuid())
  communityId           String
  userId                String
  type                  String
  loginDate             DateTime
  previousCurrentStreak Int       @default(0)
  newCurrentStreak      Int       @default(0)
  previousLongestStreak Int       @default(0)
  newLongestStreak      Int       @default(0)
  timezone              String
  createdAt             DateTime  @default(now())
  community             Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([communityId, userId])
  @@index([communityId, type])
  @@index([communityId, loginDate])
}

model CommunityEmailSettings {
  id                    String    @id @default(cuid())
  communityId           String    @unique
  enabled               Boolean   @default(false)
  smtpHost              String?
  smtpPort              Int?
  smtpUsername          String?
  smtpPasswordEncrypted String?
  smtpSecure            Boolean   @default(false)
  fromEmail             String?
  fromName              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  community             Community @relation(fields: [communityId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model EmailChangeRequest {
  id                 String    @id @default(cuid())
  userId             String
  currentEmail       String
  normalizedNewEmail String
  tokenHash          String    @unique
  expiresAt          DateTime
  verifiedAt         DateTime?
  cancelledAt        DateTime?
  activeUserId       String?   @unique
  activeNewEmail     String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([normalizedNewEmail])
  @@index([expiresAt])
}

model UserTwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  communityId String
  roleId      String
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id])
  community   Community        @relation(fields: [communityId], references: [id])
  role        Role             @relation(fields: [roleId], references: [id])
  profile     MemberProfile?
  profileLinks MemberProfileLink[]

  @@unique([userId, communityId])
}

model MemberProfileLink {
  id            String                @id @default(cuid())
  membershipId  String
  platform      ProfileLinkPlatform
  identifier    String?
  label         String?
  url           String?
  normalizedUrl String?
  legacyUrl     String?
  visibility    ProfileLinkVisibility @default(PUBLIC)
  position      Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  membership    Membership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, normalizedUrl])
  @@index([membershipId, position])
  @@index([membershipId, platform])
}

model MemberProfile {
  id           String     @id @default(cuid())
  membershipId String     @unique
  title        String?
  avatarUrl    String?
  sex          String?
  dicebearStyle String?
  dicebearSeed  String?
  bio          String?
  birthdate    DateTime?
  passportExpiresAt DateTime?
  location     String?
  interests    String[]   @default([])
  skills       String[]   @default([])
  socialLinks  Json?
  membership   Membership @relation(fields: [membershipId], references: [id])
}

model ChatConversation {
  id            String                    @id @default(cuid())
  communityId   String
  type          ChatConversationType      @default(DIRECT)
  title         String?
  avatarUrl     String?
  createdById   String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime?
  archivedAt    DateTime?
  community     Community                 @relation(fields: [communityId], references: [id])
  createdBy     User                      @relation("ChatConversationCreator", fields: [createdById], references: [id])
  participants  ChatConversationParticipant[]
  messages      ChatMessage[]
  hiddenMessages ChatMessageHidden[]
  attachments   ChatAttachment[]
  attachmentViews ChatAttachmentView[]
  messageReports ChatMessageReport[]

  @@index([communityId, updatedAt])
  @@index([createdById])
}

model ChatConversationParticipant {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  role           String           @default("MEMBER")
  joinedAt       DateTime         @default(now())
  lastReadAt     DateTime?
  mutedAt        DateTime?
  archivedAt     DateTime?
  clearedAt      DateTime?
  deletedAt      DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, deletedAt])
}

model ChatMessage {
  id                         String           @id @default(cuid())
  conversationId             String
  senderId                   String
  encryptedPayload           String
  encryptionNonce            String
  encryptionAlgorithmVersion String
  encryptionKeyVersion       String?
  senderKeyVersionId         String?
  recipientKeyVersionId      String?
  createdAt                  DateTime         @default(now())
  editedAt                   DateTime?
  deliveredAt                DateTime?
  deletedAt                  DateTime?
  deletedForEveryoneAt       DateTime?
  deletedById                String?
  conversation               ChatConversation @relation(fields: [conversationId], references: [id])
  sender                     User             @relation("ChatMessageSender", fields: [senderId], references: [id])
  deletedBy                  User?            @relation("ChatMessageDeletedBy", fields: [deletedById], references: [id])
  senderKeyVersion           ChatDeviceKey?   @relation("ChatMessageSenderKeyVersion", fields: [senderKeyVersionId], references: [id], onDelete: Restrict)
  recipientKeyVersion        ChatDeviceKey?   @relation("ChatMessageRecipientKeyVersion", fields: [recipientKeyVersionId], references: [id], onDelete: Restrict)
  hiddenForUsers             ChatMessageHidden[]
  reactions                  ChatMessageReaction[]
  stars                      ChatMessageStar[]
  reports                    ChatMessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([deletedById])
  @@index([editedAt])
  @@index([senderKeyVersionId])
  @@index([recipientKeyVersionId])
}

model ChatMessageReport {
  id             String           @id @default(cuid())
  messageId      String
  conversationId String
  communityId    String
  reporterId     String
  reportedUserId String?
  reason         String
  note           String?
  status         String           @default("OPEN")
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  message        ChatMessage      @relation(fields: [messageId], references: [id])
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  community      Community        @relation(fields: [communityId], references: [id])
  reporter       User             @relation("ChatMessageReportReporter", fields: [reporterId], references: [id])
  reportedUser   User?            @relation("ChatMessageReportReportedUser", fields: [reportedUserId], references: [id])
  resolvedBy     User?            @relation("ChatMessageReportResolvedBy", fields: [resolvedById], references: [id])

  @@unique([messageId, reporterId])
  @@index([conversationId, createdAt])
  @@index([communityId, status, createdAt])
  @@index([reportedUserId])
  @@index([reporterId])
  @@index([resolvedById])
}

model ChatUserBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("ChatUserBlockBlocker", fields: [blockerId], references: [id])
  blockedUser   User     @relation("ChatUserBlockBlocked", fields: [blockedUserId], references: [id])

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageStar {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([userId, createdAt])
}

model ChatMessageHidden {
  id             String           @id @default(cuid())
  messageId      String
  conversationId String
  userId         String
  hiddenAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  message        ChatMessage      @relation(fields: [messageId], references: [id])
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([conversationId, userId])
  @@index([userId, hiddenAt])
}

model ChatAttachment {
  id                         String           @id @default(cuid())
  communityId                String
  conversationId             String
  senderId                   String
  storageKey                 String           @unique
  encryptedSize              Int
  mediaCategory              ChatMediaCategory @default(OTHER)
  lifecycleStatus            ChatAttachmentLifecycle @default(ACTIVE)
  viewOnce                   Boolean          @default(false)
  encryptionNonce            String
  encryptionAlgorithmVersion String
  createdAt                  DateTime         @default(now())
  retentionExpiresAt         DateTime?
  deletionRequestedAt        DateTime?
  deletionCompletedAt        DateTime?
  deletionError              String?
  deletionAttempts           Int              @default(0)
  deletedAt                  DateTime?
  community                  Community        @relation(fields: [communityId], references: [id])
  conversation               ChatConversation @relation(fields: [conversationId], references: [id])
  sender                     User             @relation("ChatAttachmentSender", fields: [senderId], references: [id])
  views                      ChatAttachmentView[]
  deletionOperations         ChatMediaDeletionOperation[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([communityId, lifecycleStatus, createdAt])
  @@index([communityId, lifecycleStatus, encryptedSize, createdAt])
  @@index([communityId, mediaCategory, createdAt])
  @@index([communityId, senderId, createdAt])
  @@index([retentionExpiresAt, lifecycleStatus])
}

model ChatAttachmentView {
  id             String           @id @default(cuid())
  attachmentId   String
  conversationId String
  userId         String
  openedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  attachment     ChatAttachment   @relation(fields: [attachmentId], references: [id])
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([attachmentId, userId])
  @@index([conversationId, userId])
  @@index([userId, openedAt])
}

model ChatDevice {
  id               String           @id @default(cuid())
  communityId      String
  userId           String
  keyId            String
  deviceIdentifier String
  displayName      String
  generatedLabel   String?
  customDisplayName String?
  deviceType       ChatDeviceType   @default(UNKNOWN)
  operatingSystemName String?
  operatingSystemVersion String?
  browserName      String?
  browserVersion   String?
  status           ChatDeviceStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  revokedById      String?
  community        Community        @relation(fields: [communityId], references: [id])
  user             User             @relation("ChatDeviceUser", fields: [userId], references: [id])
  key              ChatDeviceKey    @relation(fields: [keyId], references: [id], onDelete: Restrict)
  revokedBy        User?            @relation("ChatDeviceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([communityId, userId, deviceIdentifier])
  @@index([communityId, userId, status])
  @@index([communityId, status, createdAt])
  @@index([communityId, status, lastSeenAt, createdAt])
  @@index([communityId, deviceType, lastSeenAt])
  @@index([communityId, operatingSystemName, lastSeenAt])
